<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <ImageView
        android:layout_width="112dp"
        android:layout_height="112dp"
        android:layout_marginTop="64dp"
        android:background="@drawable/bg_circle_amber"
        android:contentDescription="@null"
        android:padding="28dp"
        android:src="@drawable/ic_person"
        app:tint="@color/on_amber" />

    <TextView
        android:id="@+id/call_name"
        style="@style/Text.Display"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:textSize="26sp" />

    <TextView
        android:id="@+id/call_status"
        style="@style/Text.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:textSize="15sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/call_phone"
        style="@style/Widget.FoodRush.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/call_by_phone"
        android:visibility="gone"
        app:icon="@drawable/ic_call"
        app:iconTint="@color/amber_dark" />

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/call_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/call_mute"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginHorizontal="20dp"
            android:background="@drawable/bg_circle_surface"
            android:contentDescription="@string/mute"
            android:padding="14dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_mic" />

        <ImageButton
            android:id="@+id/call_speaker"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginHorizontal="20dp"
            android:background="@drawable/bg_circle_surface"
            android:contentDescription="@string/speaker"
            android:padding="14dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_speaker" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/call_answer"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginHorizontal="28dp"
            android:background="@drawable/bg_circle_green"
            android:contentDescription="@string/answer"
            android:padding="20dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_call"
            android:visibility="gone"
            app:tint="@android:color/white" />

        <ImageButton
            android:id="@+id/call_hangup"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginHorizontal="28dp"
            android:background="@drawable/bg_circle_red"
            android:contentDescription="@string/hang_up"
            android:padding="20dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_call_end"
            app:tint="@android:color/white" />
    </LinearLayout>
</LinearLayout>
