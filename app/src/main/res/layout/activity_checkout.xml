<?xml version="1.0" encoding="utf-8"?>
<!-- Two states: an animated "getting your order ready" loader, then the final summary to confirm. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/checkout_loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="28dp">

        <TextView
            style="@style/Text.Light"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/checkout_title_1" />

        <TextView
            style="@style/Text.Display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/checkout_title_2" />

        <com.foodrush.app.view.RouteLoadingView
            android:id="@+id/checkout_animation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="24dp" />

        <include
            android:id="@+id/checkout_step_restaurants"
            layout="@layout/item_check_step" />

        <include
            android:id="@+id/checkout_step_route"
            layout="@layout/item_check_step" />

        <include
            android:id="@+id/checkout_step_bill"
            layout="@layout/item_check_step" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/checkout_summary"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <include
            android:id="@+id/checkout_bar"
            layout="@layout/view_top_bar" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingBottom="16dp">

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.FoodRush.Card"
                    android:layout_width="match_parent"
                    android:layout_height="190dp"
                    android:layout_marginVertical="6dp"
                    app:cardElevation="2dp">

                    <org.osmdroid.views.MapView
                        android:id="@+id/checkout_map"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/checkout_route"
                    style="@style/Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.FoodRush.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="6dp">

                        <include
                            android:id="@+id/checkout_address"
                            layout="@layout/view_info_row" />

                        <include
                            android:id="@+id/checkout_time"
                            layout="@layout/view_info_row" />

                        <include
                            android:id="@+id/checkout_payment"
                            layout="@layout/view_info_row" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    style="@style/Text.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/items" />

                <TextView
                    android:id="@+id/checkout_items"
                    style="@style/Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" />

                <TableLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:stretchColumns="1">

                    <TableRow android:layout_marginTop="4dp">

                        <TextView
                            style="@style/Text.Caption"
                            android:text="@string/subtotal" />

                        <TextView
                            android:id="@+id/checkout_subtotal"
                            style="@style/Text.Caption"
                            android:gravity="end" />
                    </TableRow>

                    <TableRow
                        android:id="@+id/checkout_discount_row"
                        android:layout_marginTop="4dp">

                        <TextView
                            style="@style/Text.Caption"
                            android:text="@string/discount" />

                        <TextView
                            android:id="@+id/checkout_discount"
                            style="@style/Text.Caption"
                            android:gravity="end" />
                    </TableRow>

                    <TableRow android:layout_marginTop="4dp">

                        <TextView
                            style="@style/Text.Caption"
                            android:text="@string/vat" />

                        <TextView
                            android:id="@+id/checkout_vat"
                            style="@style/Text.Caption"
                            android:gravity="end" />
                    </TableRow>

                    <TableRow android:layout_marginTop="4dp">

                        <TextView
                            style="@style/Text.Caption"
                            android:text="@string/delivery_fee" />

                        <TextView
                            android:id="@+id/checkout_fee"
                            style="@style/Text.Caption"
                            android:gravity="end" />
                    </TableRow>

                    <TableRow android:layout_marginTop="8dp">

                        <TextView
                            style="@style/Text.Section"
                            android:text="@string/total" />

                        <TextView
                            android:id="@+id/checkout_total"
                            style="@style/Text.Section"
                            android:gravity="end" />
                    </TableRow>
                </TableLayout>

                <TextView
                    android:id="@+id/checkout_problem"
                    style="@style/Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_chip"
                    android:padding="12dp"
                    android:textColor="@color/error"
                    android:visibility="gone" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/checkout_place"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginVertical="12dp" />
    </LinearLayout>
</FrameLayout>
