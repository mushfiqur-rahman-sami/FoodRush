<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="8dp">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/coupon_code_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/coupon_code_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/coupon_code_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapCharacters"
                android:maxLength="16" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/coupon_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:checkedButton="@id/coupon_type_percent"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/coupon_type_percent"
                style="@style/Widget.FoodRush.RoleButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/coupon_percent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/coupon_type_flat"
                style="@style/Widget.FoodRush.RoleButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/coupon_flat" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/coupon_value_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="@string/coupon_value">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/coupon_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="@string/min_order_tk">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/coupon_min"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/coupon_expiry"
            style="@style/Widget.FoodRush.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:icon="@drawable/ic_clock"
            app:iconTint="@color/amber_dark" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/coupon_active"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:checked="true"
            android:text="@string/coupon_active" />
    </LinearLayout>
</ScrollView>
